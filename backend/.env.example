# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (the Next.js app, etc.).
# The Flutter app is a native client and is not subject to CORS.
CORS_ORIGINS=http://localhost:3000

# Timezone used for "today" and for the midnight rollover job (IANA name).
APP_TIMEZONE=Asia/Kolkata
# Cron expression for the rollover job, evaluated in APP_TIMEZONE. Default: midnight.
ROLLOVER_CRON=0 0 * * *

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dev-tracker?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
